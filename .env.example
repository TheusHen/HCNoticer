# MailerSend API Token (starts with mlsn.)
MAILERSEND_API_KEY=mlsn.xxxxx

# Email Configuration
EMAIL_FROM_NAME=HCNoticer
EMAIL_FROM_EMAIL=noreply@your-domain.com
EMAIL_TO=recipient@example.com

# Data sources
YSWS_API_URL=https://raw.githubusercontent.com/hackclub/YSWS-Catalog/main/api.json

# Devpost (general hackathons — public API, no auth)
# Only online + open hackathons are kept (client-side filter).
DEVPOST_API_URL=https://devpost.com/api/hackathons
# How many Devpost pages to fetch per run (each page ~9 items)
DEVPOST_MAX_PAGES=5
# Optional keyword filter (matches title/org/themes, case-insensitive). Empty = all.
DEVPOST_SEARCH=

# Max new events per source section in the email (YSWS and Devpost)
EMAIL_MAX_PER_SOURCE=10

# State file path (where known events are persisted)
STATE_FILE=./data/state.json

# Continuous mode interval, used by Fly.io / long-running workers
HCNOTICER_INTERVAL_SECONDS=300
